rules_version = '2';

// Un document par (question, votant) : votes/{question}__{votant}.
// Les identifiants des votants doivent correspondre à VOTERS dans js/data.js.
service cloud.firestore {
  match /databases/{database}/documents {
    match /votes/{voteId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['question', 'voter', 'choices', 'comment', 'updatedAt'])
        && request.resource.data.keys().hasAll(['question', 'voter', 'choices', 'comment', 'updatedAt'])
        && request.resource.data.voter in ['frere1', 'frere2', 'frere3']
        && request.resource.data.question is string
        && request.resource.data.question.size() <= 40
        && voteId == request.resource.data.question + '__' + request.resource.data.voter
        && request.resource.data.choices is list
        && request.resource.data.choices.size() <= 10
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
